# AI Teaching Assistant System - Docker Environment Configuration
# 这个文件包含Docker Compose环境所需的环境变量

# ========================================
# Database Configuration (PostgreSQL)
# ========================================
POSTGRES_DB=ai_teacher_dev
POSTGRES_USER=ai_teacher
POSTGRES_PASSWORD=dev_password_123
DATABASE_URL=postgresql+asyncpg://ai_teacher:dev_password_123@database:5432/ai_teacher_dev

# ========================================
# Redis Configuration
# ========================================
REDIS_PASSWORD=dev_redis_123
REDIS_URL=redis://:dev_redis_123@redis:6379/0

# ========================================
# Application Configuration
# ========================================
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=dev-secret-key-change-in-production-123456789

# ========================================
# OpenAI API Configuration (for AI Backend)
# ========================================
# 请在此处设置你的OpenAI API密钥
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ========================================
# Service URLs (内部容器通信)
# ========================================
BACKEND_URL=http://backend:8000
AI_BACKEND_URL=http://ai-backend:8001

# ========================================
# Frontend Configuration
# ========================================
VITE_API_BASE_URL=http://localhost:8000
VITE_AI_API_BASE_URL=http://localhost:8001
VITE_WS_URL=ws://localhost:8000/ws
NODE_ENV=development

# ========================================
# Monitoring & Admin Tools
# ========================================
PGADMIN_DEFAULT_EMAIL=admin@aiteacher.local
PGADMIN_DEFAULT_PASSWORD=admin123
REDIS_COMMANDER_USER=admin
REDIS_COMMANDER_PASSWORD=admin123
GRAFANA_ADMIN_PASSWORD=admin123

# ========================================
# Development & Testing
# ========================================
PYTHONPATH=/app/src
LOG_LEVEL=INFO
MAX_WORKERS=4

# ========================================
# File Upload & Storage
# ========================================
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes
UPLOAD_DIR=/app/uploads
ALLOWED_EXTENSIONS=py,c,cpp,txt,md

# ========================================
# Security Settings
# ========================================
CORS_ORIGINS=http://localhost:3001,http://localhost:3000,http://frontend:5173
JWT_SECRET_KEY=dev-jwt-secret-key-change-in-production
JWT_EXPIRE_MINUTES=1440

# ========================================
# Database Connection Pool
# ========================================
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# ========================================
# Cache Configuration
# ========================================
CACHE_TTL=3600
CACHE_MAX_ENTRIES=1000