# =================================
# AI教学助手系统 - 环境变量配置模板
# =================================

# 应用基本配置
PROJECT_NAME="AI Teaching Assistant System"
VERSION="1.0.0"
ENVIRONMENT="development"  # development, production, testing
DEBUG="true"

# 服务器配置
HOST="0.0.0.0"
PORT="8000"
ALLOWED_HOSTS="*"  # 生产环境请设置具体域名，如：api.aiteacher.com,localhost

# 安全配置
SECRET_KEY="your-super-secret-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES="1440"  # 24小时
REFRESH_TOKEN_EXPIRE_DAYS="30"
ALGORITHM="HS256"

# 数据库配置
DATABASE_URL="postgresql+asyncpg://ai_teacher:password@localhost:5432/ai_teacher_db"
DATABASE_ECHO="false"  # 生产环境设为false
DATABASE_POOL_SIZE="10"
DATABASE_MAX_OVERFLOW="20"

# Redis配置 (缓存和会话存储)
REDIS_URL="redis://localhost:6379/0"
REDIS_EXPIRE_TIME="3600"  # 1小时

# AI服务配置
OPENAI_API_KEY="sk-your-openai-api-key-here"
OPENAI_MODEL="gpt-4"
MAX_AI_SESSIONS="50"
AI_RESPONSE_TIMEOUT="30"

# 文件上传配置
UPLOAD_DIR="uploads"
MAX_FILE_SIZE="10485760"  # 10MB
ALLOWED_EXTENSIONS="py,c,cpp,java,js,ts,txt"

# 日志配置
LOG_LEVEL="INFO"
LOG_DIR="logs"
LOG_ROTATION="1 day"
LOG_RETENTION="30 days"

# 邮件配置 (用于通知)
SMTP_SERVER="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USERNAME="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
EMAIL_FROM="noreply@aiteacher.com"

# 性能配置
MAX_CONCURRENT_REQUESTS="100"
REQUEST_TIMEOUT="30"
RATE_LIMIT_PER_MINUTE="60"

# 功能开关
ENABLE_SIGNUP="true"
ENABLE_DEBUGGING_MODE="true"
ENABLE_BATCH_PROCESSING="true"
ENABLE_METRICS_COLLECTION="true"

# 监控配置
PROMETHEUS_PORT="9090"
HEALTH_CHECK_INTERVAL="30"

# 部署配置 (生产环境)
# NGINX_CONF_PATH="/etc/nginx/sites-available/ai-teacher"
# SSL_CERT_PATH="/path/to/ssl/cert.pem"
# SSL_KEY_PATH="/path/to/ssl/private.key"
# BACKUP_S3_BUCKET="ai-teacher-backups"
# AWS_ACCESS_KEY_ID="your-aws-access-key"
# AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
# AWS_REGION="us-west-2"

# 开发环境特定配置
# 仅在开发环境使用，生产环境请删除
DEV_AUTO_RELOAD="true"
DEV_SHOW_DOCS="true"
DEV_LOG_SQL="false"

# 测试环境配置
# TEST_DATABASE_URL="postgresql+asyncpg://test:test@localhost:5432/ai_teacher_test"
# TEST_REDIS_URL="redis://localhost:6379/1"